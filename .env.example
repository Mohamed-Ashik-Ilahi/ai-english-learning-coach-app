# ====================================================================
# English AI Coach - Environment Variables
# ====================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Keep this secret on the backend server. NEVER expose it to client-side code.
# In AI Studio, this is automatically injected from user secrets.
# For self-hosted backends, obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Server listening port for Node.js Express backend (default: 3000)
PORT=3000

# VITE_BACKEND_URL: Optional client-side URL for the Android APK to reach your backend.
# In web browsers, leave empty to use relative /api routes.
# For Android Emulator testing: "http://10.0.2.2:3000"
# For Android Physical Phone on local Wi-Fi: "http://192.168.1.XXX:3000"
# For Deployed Production Backend: "https://your-backend-service.run.app"
# Note: You can also configure and test this URL directly in the app's Settings menu!
VITE_BACKEND_URL=""

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins.
# Defaults permit capacitor://localhost, https://localhost, and local network IPs.
CORS_ALLOWED_ORIGINS="https://localhost,capacitor://localhost,http://localhost:3000,http://10.0.2.2:3000"

# APP_URL: Public URL where the application or backend is hosted.
APP_URL="MY_APP_URL"
